#!/bin/sh
# Claude Code com o canal do orbe: o orbe de voz passa a falar com esta sessão.
# Formas --flag=valor porque essas opções aceitam vários valores e engoliriam "$@".
# O orbe_aceite.py confirma sozinho o aviso dos canais de desenvolvimento.
ORBE=$(dirname "$(readlink -f "$0")")
# o canal e o aceite só usam a stdlib: o Python do venv do orbe, ou qualquer python3
PY=$ORBE/.venv/bin/python
[ -x "$PY" ] || PY=$(command -v python3)
exec "$PY" "$ORBE/orbe_aceite.py" claude \
  --mcp-config="{\"mcpServers\":{\"orbe\":{\"type\":\"stdio\",\"command\":\"$PY\",\"args\":[\"$ORBE/orbe_canal.py\"]}}}" \
  --dangerously-load-development-channels=server:orbe \
  --allowedTools=mcp__orbe__reply \
  "$@"
