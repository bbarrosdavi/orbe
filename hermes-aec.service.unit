[Unit]
# O MÓDULO em si sobe pelo PipeWire, via
# ~/.config/pipewire/pipewire.conf.d/99-hermes-echo-cancel.conf — lá está o
# monitor.mode, que filtra só a captura e não encosta no playback.
#
# Esta unit faz uma coisa só: apontar a fonte padrão para a fonte filtrada.
# O daemon de voz captura pelo nó "pipewire" do ALSA, que segue a fonte
# padrão; sem este passo ele continuaria ouvindo o microfone cru.
Description=Fonte padrão no microfone com cancelamento de eco do Hermes
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service wireplumber.service
PartOf=pipewire.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Espera o nó aparecer: o módulo do PipeWire e esta unit sobem em paralelo.
ExecStart=/usr/bin/bash -c '\
  for i in $(seq 1 25); do \
    pactl list short sources | grep -q "hermes_aec_source" && break; \
    sleep 0.4; \
  done; \
  pactl set-default-source hermes_aec_source'
ExecStop=/usr/bin/bash -c '\
  pactl set-default-source \
    alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Mic1__source || true'

[Install]
WantedBy=default.target
