# Modelo da unit do usuário; o install.sh troca @ORBE@ pela pasta do repo e
# @PY@ pelo Python que tem as dependências do daemon.
[Unit]
Description=Orbe: daemon de voz
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=@PY@ @ORBE@/hermes_voice_daemon.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
Environment=PATH=%h/.hermes/hermes-agent/venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=XDG_SESSION_TYPE=wayland
Environment=GDK_BACKEND=wayland

[Install]
WantedBy=graphical-session.target
