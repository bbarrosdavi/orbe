[Unit]
# O MÓDULO em si sobe pelo PipeWire, via
# ~/.config/pipewire/pipewire.conf.d/99-orbe-echo-cancel.conf — lá está o
# monitor.mode, que filtra só a captura e não encosta no playback.
#
# Esta unit faz uma coisa só: apontar a fonte padrão para a fonte filtrada.
# O daemon de voz captura pelo nó "pipewire" do ALSA, que segue a fonte
# padrão; sem este passo ele continuaria ouvindo o microfone cru.
#
# A lógica vive num script versionado no repo, e não inline aqui, para ser
# testável fora do systemd. Modelo: o install.sh troca @ORBE@ pela pasta.
Description=Orbe: fonte padrão no microfone com cancelamento de eco
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service wireplumber.service
PartOf=pipewire.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=XDG_RUNTIME_DIR=%t
ExecStart=@ORBE@/orbe_aec_default.sh set
ExecStop=@ORBE@/orbe_aec_default.sh restore

[Install]
WantedBy=default.target
