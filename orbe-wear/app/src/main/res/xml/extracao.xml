<?xml version="1.0" encoding="utf-8"?>
<!-- Os ajustes guardam o token da ponte: nada sai do relógio em backup nem em transferência. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
